# Modèle de /srv/secrets/unison.env (v2). Créer avec :
#   sudo install -m 600 /dev/null /srv/secrets/unison.env
# puis remplir. Jamais dans Git.

# Base (lus par le conteneur MariaDB à sa première création)
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
# Même mot de passe que MARIADB_PASSWORD
DATABASE_URL=mysql://unison:MOT_DE_PASSE@db:3306/unison?serverVersion=12.2.2-MariaDB&charset=utf8mb4

# Symfony : une longue chaîne aléatoire (openssl rand -hex 32). La changer déconnecte tout le monde.
APP_SECRET=

# E-mails par Resend (la clé API est le mot de passe SMTP, l'utilisateur est « resend »)
MAILER_DSN=smtp://resend:CLE_RESEND@smtp.resend.com:587
MAILER_FROM=noreply@mail.pi5.ovh
