<nav class="navbar">
    {# Five quick clicks: the little character peeks out at once (secret_clicks_controller.js). #}
    <div class="nav-brand desktop-only" data-controller="secret-clicks" data-secret-clicks-event-value="unison:peek" data-action="click->secret-clicks#count">Unison</div>
    <a class="nav-item" aria-current="{{ section == 'home' ? 'page' : 'false' }}" href="{{ path('app_home') }}">
        {{ ux_icon('material-symbols:home' ~ (section == 'home' ? '' : '-outline' )) }}
        <span class="nav-label">Accueil</span>
    </a>
    <a class="nav-item" aria-current="{{ section == 'library' ? 'page' : 'false' }}" href="{{ path('app_library') }}">
        {{ ux_icon('material-symbols:library-music' ~ (section == 'library' ? '' : '-outline' )) }}
        <span class="nav-label">Bibliothèque</span>
    </a>
    <a class="nav-item" aria-current="{{ section == 'import' ? 'page' : 'false' }}" href="{{ path('app_import') }}">
        {{ ux_icon('material-symbols:download') }}
        <span class="nav-label">Importer</span>
    </a>
    <a class="nav-item" aria-current="{{ section == 'account' ? 'page' : 'false' }}" href="{{ path('app_account') }}">
        {{ ux_icon('material-symbols:person' ~ (section == 'account' ? '' : '-outline' )) }}
        <span class="nav-label">Compte</span>
    </a>
    {% if is_granted('ROLE_ADMIN') %}
        <a class="nav-item" aria-current="{{ section == 'admin' ? 'page' : 'false' }}" href="{{ path('app_admin') }}">
            {{ ux_icon('material-symbols:admin-panel-settings' ~ (section == 'admin' ? '' : '-outline' )) }}
            <span class="nav-label">Admin</span>
        </a>
    {% endif %}
</nav>
