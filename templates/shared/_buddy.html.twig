{# The little character of Unison: a round fellow with headphones, waving hello once per visit
   (buddy_controller.js) and again when the mouse passes over him. Decoration only. #}
<span class="buddy{{ class is defined ? ' ' ~ class }}" data-controller="buddy" data-action="mouseenter->buddy#wave" aria-hidden="true">
    <svg viewBox="0 0 40 44" focusable="false">
        <ellipse class="buddy-body" cx="20" cy="40" rx="11" ry="7"/>
        <g class="buddy-arm">
            <path class="buddy-skin-line" d="M29 36 L35 27"/>
            <circle class="buddy-skin" cx="35.6" cy="25.8" r="2.6"/>
        </g>
        <circle class="buddy-skin" cx="20" cy="21" r="11"/>
        <circle class="buddy-eye" cx="16" cy="20.5" r="1.4"/>
        <circle class="buddy-eye" cx="24" cy="20.5" r="1.4"/>
        <path class="buddy-smile" d="M16.5 25 Q20 28 23.5 25"/>
        <path class="buddy-headband" d="M8.5 20 A11.5 11.5 0 0 1 31.5 20"/>
        <rect class="buddy-cup" x="5.5" y="17" width="5" height="9" rx="2.5"/>
        <rect class="buddy-cup" x="29.5" y="17" width="5" height="9" rx="2.5"/>
    </svg>
</span>
