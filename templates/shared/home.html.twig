{% extends 'base.html.twig' %}

{% block section %}home{% endblock %}

{% block body %}
{% set hour = 'now'|date('G') %}
<div class="home">
    {# On a phone, the little character of the sidebar says hello here. #}
    <h1 class="home-greeting">{{ hour < 18 ? 'Bonjour' : 'Bonsoir'}}, <em>{{ app.user.username }}</em>{% include 'shared/_buddy.html.twig' with {class: 'buddy--greeting'} %}</h1>
    <p class="home-subtitle">Que veux-tu écouter aujourd'hui ?</p>

    <div class="home-columns">
        <div class="home-main">
            <section class="home-section">
                <h2>À découvrir</h2>
                <ul class="discover-grid" data-controller="discover">
                    {% for track in discoverTracks %}
                        <li>
                            {% include "library/_track_card.html.twig" %}
                        </li>
                    {% endfor %}
                </ul>
            </section>
            <section class="home-section">
                <div class="home-section-header">
                    <h2>Albums récents</h2>
                    <a href="{{ path('app_albums') }}">Voir tout</a>
                </div>
                <ul class="album-grid">
                    {% for album in recentAlbums %}
                        <li>
                            {% include "library/_album_card.html.twig" %}
                        </li>
                    {% else %}
                        <li>Aucun album pour l'instant</li>
                    {% endfor %}
                </ul>
            </section>
            <section class="home-section">
                <div class="home-section-header">
                    <h2>Artistes</h2>
                    <a href="{{ path('app_artists') }}">Voir tout</a>
                </div>
                <ul class="artist-grid">
                    {% for artist in topArtists %}
                        <li>
                            {% include "library/_artist_card.html.twig" %}
                        </li>
                    {% else %}
                        <li>Aucun artiste pour l'instant</li>
                    {% endfor %}
                </ul>
            </section>
        </div>
        <aside class="home-side">
            <section class="home-section">
                <div class="home-section-header">
                    <h2>Tes playlists</h2>
                    <a href="{{ path('app_playlists') }}">Voir tout</a>
                </div>
                <ul class="playlist-list">
                    {% for playlist in recentPlaylists %}
                        <li>
                            {% include "playlist/_playlist_row.html.twig" %}
                        </li>
                    {% else %}
                        <li>Aucune playlist pour l'instant</li>
                    {% endfor %}
                </ul>
            </section>
            <section class="home-section">
                <div class="home-section-header">
                    <h2>Tes favoris</h2>
                    <a href="{{ path('app_favorites') }}">Voir tout</a>
                </div>
                {% include "library/_track_list.html.twig" with {favoritesList: true} %}
            </section>
        </aside>
    </div>
</div>
{% endblock %}
