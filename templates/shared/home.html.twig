{% extends 'base.html.twig' %}

{% block section %}home{% endblock %}

{% block body %}
{% set hour = 'now'|date('G') %}
{# The day the account was created, a year or more ago (29 February: the 28th in other years). #}
{% set created = app.user.createdAt %}
{% set years = 'now'|date('Y') - created|date('Y') %}
{% set birthday = created|date('m-d') == '02-29' and 'now'|date('L') == '0' ? '02-28' : created|date('m-d') %}
{% set anniversary = years > 0 and birthday == 'now'|date('m-d') %}
<div class="home">
    {% if anniversary %}
        {# A cloud of butterflies, once that day (anniversary_controller.js). #}
        <h1 class="home-greeting" data-controller="anniversary">Joyeux anniversaire, <em>{{ app.user.username }}</em></h1>
        <p class="home-subtitle">Déjà {{ years }} an{{ years > 1 ? 's' }} sur Unison ! Que veux-tu écouter aujourd'hui ?</p>
    {% else %}
        <h1 class="home-greeting">{{ hour < 18 ? 'Bonjour' : 'Bonsoir'}}, <em>{{ app.user.username }}</em></h1>
        <p class="home-subtitle">Que veux-tu écouter aujourd'hui ?</p>
    {% endif %}

    <div class="home-columns">
        <div class="home-main">
            <section class="home-section">
                <h2>À découvrir</h2>
                <ul class="discover-grid" data-controller="discover">
                    {% for track in discoverTracks %}
                        <li>
                            {% include "library/_track_card.html.twig" %}
                        </li>
                    {% endfor %}
                </ul>
            </section>
            <section class="home-section">
                <div class="home-section-header">
                    <h2>Albums récents</h2>
                    <a href="{{ path('app_albums') }}">Voir tout</a>
                </div>
                <ul class="album-grid">
                    {% for album in recentAlbums %}
                        <li>
                            {% include "library/_album_card.html.twig" %}
                        </li>
                    {% else %}
                        <li>Aucun album pour l'instant</li>
                    {% endfor %}
                </ul>
            </section>
            <section class="home-section">
                <div class="home-section-header">
                    <h2>Artistes</h2>
                    <a href="{{ path('app_artists') }}">Voir tout</a>
                </div>
                <ul class="artist-grid">
                    {% for artist in topArtists %}
                        <li>
                            {% include "library/_artist_card.html.twig" %}
                        </li>
                    {% else %}
                        <li>Aucun artiste pour l'instant</li>
                    {% endfor %}
                </ul>
            </section>
        </div>
        <aside class="home-side">
            <section class="home-section">
                <div class="home-section-header">
                    <h2>Tes playlists</h2>
                    <a href="{{ path('app_playlists') }}">Voir tout</a>
                </div>
                <ul class="playlist-list">
                    {% for playlist in recentPlaylists %}
                        <li>
                            {% include "playlist/_playlist_row.html.twig" %}
                        </li>
                    {% else %}
                        <li>Aucune playlist pour l'instant</li>
                    {% endfor %}
                </ul>
            </section>
            <section class="home-section">
                <div class="home-section-header">
                    <h2>Tes favoris</h2>
                    <a href="{{ path('app_favorites') }}">Voir tout</a>
                </div>
                {% include "library/_track_list.html.twig" with {favoritesList: true} %}
            </section>
        </aside>
    </div>
</div>
{% endblock %}
