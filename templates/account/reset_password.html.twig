{% extends 'base.html.twig' %}

{% block title %}Unison - Choisir un mot de passe{% endblock %}

{% block body %}
<div class="login">
    <h1>Unison</h1>
    <p class="login-intro">Bonjour {{ user.username }}, choisis ton mot de passe. Tu te connecteras ensuite avec <strong>{{ user.email }}</strong>.</p>

    {{ form_start(form, {attr: {class: 'form'}}) }}
        {{ form_row(form.newPassword) }}
        <button type="submit" class="btn">Enregistrer</button>
    {{ form_end(form) }}
</div>
{% endblock %}
