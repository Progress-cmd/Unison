{% extends 'base.html.twig' %}

{% block title %}Unison - Connexion{% endblock %}

{% block body %}
<div class="login">
    <h1>Unison</h1>
    {% if error %}
        {% if error.messageKey starts with 'Too many' %}
            <p class="alert alert-error">Trop de tentatives de connexion. Réessayez dans {{ error.messageData['%minutes%'] }} minute(s).</p>
        {% else %}
            <p class="alert alert-error">Identifiants invalides.</p>
        {% endif %}
    {% endif %}
    <form method="post" class="form">
        <label>Adresse e-mail <input type="email" name="_username" value="{{ last_username }}" required autofocus></label>
        <label>Mot de passe <input type="password" name="_password" required></label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="btn">Se connecter</button>
    </form>
</div>
{% endblock %}
