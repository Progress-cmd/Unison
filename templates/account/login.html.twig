{% extends 'base.html.twig' %}

{% block title %}Unison - Connexion{% endblock %}

{% block body %}
<div class="login">
    <h1>Unison</h1>
    {% if error %}
        {% if error.messageKey starts with 'Too many' %}
            <p class="alert alert-error">Trop de tentatives de connexion. Réessayez dans {{ error.messageData['%minutes%'] }} minute(s).</p>
        {% elseif error.messageKey == constant('App\\Account\\Security\\UserChecker::DISABLED_MESSAGE') %}
            <p class="alert alert-error">{{ error.messageKey }}</p>
        {% else %}
            <p class="alert alert-error">Identifiants invalides.</p>
        {% endif %}
    {% endif %}
    <form method="post" class="form" data-controller="login">
        <label>Adresse e-mail <input type="email" name="_username" value="{{ last_username }}" required autofocus data-login-target="email"></label>
        <label>Mot de passe <input type="password" name="_password" required></label>
        {# The address goes along: the one of a failed attempt here, the one typed in login_controller.js. #}
        <a class="login-forgot" href="{{ path('app_forgot_password', last_username ? {email: last_username} : {}) }}" data-action="login#forgot">Mot de passe oublié ?</a>
        <label class="form-check">
            <input type="checkbox" name="_remember_me" checked>
            Se souvenir de moi
        </label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" data-controller="csrf-protection">
        <button type="submit" class="btn">Se connecter</button>
    </form>
</div>
{% endblock %}
