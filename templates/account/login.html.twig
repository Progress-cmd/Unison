{% extends 'base.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block body %}
    <form method="post">
        {% if error %}
            <p>{{ error.messageKey }}</p>
        {% endif %}

        <label>Email <input type="email" name="_username" value="{{ last_username }}" required autofocus></label>
        <label>Password <input type="password" name="_password" required></label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit">Sign in</button>
    </form>
{% endblock %}
