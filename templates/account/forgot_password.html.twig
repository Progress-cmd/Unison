{% extends 'base.html.twig' %}

{% block title %}Unison - Mot de passe oublié{% endblock %}

{% block body %}
<div class="login">
    <h1>Unison</h1>
    <p class="login-intro">Indique l'adresse de ton compte : tu recevras un lien pour choisir un nouveau mot de passe.</p>

    {{ form_start(form, {attr: {class: 'form'}}) }}
        {{ form_row(form.email) }}
        <button type="submit" class="btn">Envoyer le lien</button>
    {{ form_end(form) }}

    <a class="login-back" href="{{ path('app_login') }}">
        {{ ux_icon('material-symbols:arrow-back') }}
        Retour à la connexion
    </a>
</div>
{% endblock %}
