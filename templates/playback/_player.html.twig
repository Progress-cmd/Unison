<div
    id="player"
    class="player"
    data-controller="player"
    data-action="
        track-list:play@window->player#play
        keydown.esc@window->player#collapse
        click@window->player#wakeSound
    "
    data-turbo-permanent
>
    <button
        type="button"
        class="icon-btn player-close"
        aria-label="Fermer le lecteur détaillé"
        data-action="player#collapse"
    >
        {{ ux_icon('material-symbols:keyboard-arrow-down') }}
    </button>

    <button
        type="button"
        class="player-track"
        aria-label="Lecteur détaillé"
        aria-expanded="false"
        data-player-target="expand"
        data-action="player#toggleExpanded"
    >
        <img class="track-cover desktop-only" data-player-target="cover" alt="">
        <span class="track-info">
            <span class="track-title" data-player-target="title"></span>
            <span class="track-artists" data-player-target="artists"></span>
        </span>
    </button>

    <div class="player-controls">
        <button
            type="button"
            class="icon-btn player-option"
            aria-label="Lecture aléatoire"
            aria-pressed="false"
            data-player-target="shuffle"
            data-action="player#toggleShuffle"
        >
            {{ ux_icon('material-symbols:shuffle') }}
        </button>
        <button
            type="button"
            class="icon-btn"
            aria-label="Morceau précédent"
            data-action="player#previous"
        >
            {{ ux_icon('material-symbols:skip-previous') }}
        </button>

        <button
            type="button"
            class="icon-btn player-play"
            aria-label="Lecture"
            data-player-target="toggle"
            data-action="player#toggle"
        >
            {{ ux_icon('material-symbols:play-arrow', {class: 'icon-play'}) }}
            {{ ux_icon('material-symbols:pause', {class: 'icon-pause'}) }}
        </button>

        <button
            type="button"
            class="icon-btn"
            aria-label="Morceau suivant"
            data-action="player#next"
        >
            {{ ux_icon('material-symbols:skip-next') }}
        </button>

        <button
            type="button"
            class="icon-btn player-option"
            aria-label="Répéter"
            aria-pressed="false"
            data-player-target="repeat"
            data-action="player#toggleRepeat"
        >
            {{ ux_icon('material-symbols:repeat', {class: 'icon-repeat'}) }}
            {{ ux_icon('material-symbols:repeat-one', {class: 'icon-repeat-one'}) }}
        </button>
    </div>

    <span class="player-time desktop-only player-elapsed " data-player-target="elapsed">0:00</span>

    <div class="player-wave">
        <div class="player-bars" data-player-target="bars"></div>
        <input
            class="player-progress"
            type="range"
            min="0"
            max="100"
            value="0"
            step="0.1"
            aria-label="Position dans le morceau"
            data-player-target="progress"
            data-action="input->player#seek"
        >
    </div>

    <span class="player-time desktop-only player-duration" data-player-target="duration">0:00</span>

    <div class="player-volume">
        {{ ux_icon('material-symbols:volume-up') }}
        <input
            type="range"
            min="0"
            max="1"
            step="0.01"
            value="1"
            aria-label="Volume"
            data-action="input->player#setVolume"
        >
    </div>

    <section class="player-upcoming">
        <h2>À suivre</h2>
        <ol class="player-queue" data-player-target="upcoming"></ol>
        <template data-player-target="upcomingRow">
            <li>
                <button type="button" class="player-queue-row" data-action="player#jumpTo">
                    <span class="track-title"></span>
                    <span class="track-artists"></span>
                </button>
            </li>
        </template>
    </section>

    <audio
        data-player-target="audio"
        data-action="
            play->player#showPlaying
            pause->player#showPaused
            loadedmetadata->player#updateDuration
            timeupdate->player#updateProgress
            ended->player#trackEnded
        "
    ></audio>
</div>
