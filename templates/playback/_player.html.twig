<div id="player" class="player" data-controller="player" data-action="track-list:play@window->player#play" data-turbo-permanent>
    <div class="player-track">
        <img class="track-cover desktop-only" data-player-target="cover" alt="">
        <div class="track-info">
            <span class="track-title" data-player-target="title"></span>
            <span class="track-artists" data-player-target="artists"></span>
        </div>
    </div>

    <div class="player-controls">
        <button class="icon-btn" type="button" data-action="player#previous" aria-label="Morceau précédent">{{ ux_icon('material-symbols:skip-previous') }}</button>
        <button type="button" class="icon-btn player-play" data-player-target="toggle" data-action="player#toggle" aria-label="Lecture">
            {{ ux_icon('material-symbols:play-arrow', {class: 'icon-play'}) }}
            {{ ux_icon('material-symbols:pause', {class: 'icon-pause'}) }}
        </button>
        <button class="icon-btn" type="button" data-action="player#next" aria-label="Morceau suivant">{{ ux_icon('material-symbols:skip-next') }}</button>
    </div>

    <span class="player-time desktop-only" data-player-target="elapsed">0:00</span>
    <div class="player-wave">
        <div class="player-bars" data-player-target="bars"></div>
        <input class="player-progress" type="range" min="0" max="100" value="0" step="0.1" aria-label="Position dans le morceau" data-player-target="progress" data-action="input->player#seek">
    </div>
    <span class="player-time desktop-only" data-player-target="duration">0:00</span>
    
    <div class="player-volume">
        {{ ux_icon('material-symbols:volume-up') }}
        <input type="range" min="0" max="1" step="0.01" value="1" aria-label="Volume" data-action="input->player#setVolume">
    </div>

    <audio data-player-target="audio" data-action="play->player#showPlaying pause->player#showPaused loadedmetadata->player#updateDuration timeupdate->player#updateProgress ended->player#next"></audio>
</div>