{% extends 'base.html.twig' %}

{% block title %}Unison - Playlists{% endblock %}

{% block body %}
{% include 'library/_tabs.html.twig' with {active: 'playlists'} %}
<h1>Playlists</h1>
{{ form_start(form, {attr: {class: 'form playlist-create'}}) }}
    {{ form_row(form.name) }}
    <button type="submit" class="btn">Créer</button>
{{ form_end(form) }}
<h2>Nos playlists</h2>
<ul class="playlist-list">
    {% for playlist in playlists %}
        <li>
            <a href="{{ path('app_playlist_show', {'id': playlist.id}) }}" class="playlist-row">
                <span class="playlist-cover">
                    {{ ux_icon('material-symbols:queue-music') }}
                </span>
                <span class="playlist-info">
                    <span class="playlist-name">
                        {{ playlist.name }}
                    </span>
                    <span class="playlist-meta">
                        {{ playlist.createdBy.username }} · 
                        {{ playlist.playlistTracks | length }}{% if playlist.playlistTracks | length < 2 %} titre{% else %} titres{% endif %}
                    </span>
                </span>
                <span class="playlist-chevron">
                    {{ ux_icon('material-symbols:chevron-right') }}
                </span>
            </a>
        </li>
    {% else %}
        <li>Aucune playlist</li>
    {% endfor %}
</ul>
{% endblock %}
