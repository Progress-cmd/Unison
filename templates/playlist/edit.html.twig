{% extends 'base.html.twig' %}

{% block title %}Unison - Playlist{% endblock %}

{% block body %}
{% include 'library/_tabs.html.twig' with {active: 'playlists'} %}
<h1>Modifier {{ playlist.name }}</h1>
{{ form_start(form, {attr: {class: 'form playlist-create'}}) }}
    {{ form_row(form.name) }}
    <button type="submit" class="btn">Modifier</button>
{{ form_end(form) }}
<a class="back-link" href="{{ path('app_playlist_show', {'id': playlist.id}) }}">
    {{ ux_icon('material-symbols:arrow-back') }}
    Retour
</a>
{% endblock %}