{% extends 'base.html.twig' %}

{% block title %}Unison - Bibliothèque{% endblock %}

{% block body %}
<h1>Bibliothèque</h1>
<ul class="track-list" data-controller="track-list">
    {% for track in tracks %}
        {% include 'library/_track.html.twig' with {index: loop.index0} %}
    {% else %}
        <li>Aucun morceau pour l'instant.</li>
    {% endfor %}
</ul>
{% endblock %}
