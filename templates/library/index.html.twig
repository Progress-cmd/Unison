{% extends 'base.html.twig' %}

{% block title %}Unison - Bibliothèque{% endblock %}

{% block body %}
<h1>Bibliothèque</h1>
<ul class="track-list">
    {% for track in tracks %}
        <li class="track" data-controller="track" data-track-url-value="{{ path('app_track_stream', {id: track.id}) }}" data-track-title-value="{{ track.title }}">
            <button type="button" data-action="track#play" aria-label="Lire {{ track.title }}">▶</button>
            {% if track.cover %}
                <img class="track-cover" src="{{ track.cover }}" alt="" loading="lazy">
            {% else %}
                <div class="track-cover"></div>
            {% endif %}
            <div class="track-info">
                <span class="track-title">{{ track.title }}</span>
                <span class="track-artists">{{ track.artists|map(artist => artist.name)|join(', ') }}</span>
            </div>
            <span class="track-duration">{{ track.duration|duration }}</span>
        </li>
    {% else %}
        <li>Aucun morceau pour l'instant.</li>
    {% endfor %}
</ul>
{% endblock %}
