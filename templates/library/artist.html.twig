{% extends 'base.html.twig' %}

{% block title %}Unison - Artiste{% endblock %}

{% block body %}
{% include 'library/_tabs.html.twig' with {active: 'artists'} %}
<div class="artist-header">
    {% if artist.image %}
        <img class="artist-image" src="{{ artist.image }}" alt="">
    {% else %}
        <div class="artist-image">{{ artist.name|first|upper }}</div>
    {% endif %}
    <div class="artist-info">
        <h1>{{ artist.name }}</h1>
        <span class="artist-tracks">{% if artist.tracks|length == 0 %}Aucun titre{% elseif artist.tracks|length == 1%}1 titre{% else %}{{ artist.tracks|length }} titres{% endif %}</span>
    </div>
</div>
{% if artist.albums is not empty %}
    <h2>Albums</h2>
    <ul class="album-grid">
        {% for album in artist.albums %}
            <li>
                {% include 'library/_album_card.html.twig' %}
            </li>
        {% endfor %}
    </ul>
{% endif %}

<h2>Titres</h2>
{% include 'library/_track_list.html.twig' %}
{% endblock %}
