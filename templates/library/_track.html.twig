{% set artists = track.artists|map(artist => artist.name)|join(', ') %}

<li
    class="track"
    data-track-list-target="track"
    data-url="{{ path('app_track_stream', {id: track.id}) }}"
    data-title="{{ track.title }}"
    data-artists="{{ artists }}"
    data-cover="{{ track.cover }}"
    data-waveform="{{ track.waveform }}"
    {% if inPlaylist is defined %}style="view-transition-name: track-{{ track.id }}"{% endif %}
>
    <button
        type="button"
        class="icon-btn"
        aria-label="Lire {{ track.title }}"
        data-action="track-list#play"
        data-track-list-index-param="{{ index }}"
    >
        {{ ux_icon('material-symbols:play-arrow') }}
    </button>

    {% if track.cover %}
        <img class="track-cover" src="{{ track.cover }}" alt="" loading="lazy">
    {% else %}
        <div class="track-cover"></div>
    {% endif %}

    <div class="track-info">
        <span class="track-title">{{ track.title }}</span>
        <span class="track-artists">{{ artists }}</span>
        {% if user is defined %}
            <span class="track-user">{{ user }}</span>
        {% endif %}
    </div>

    <span class="track-duration">{{ track.duration|duration }}</span>
    {% if inPlaylist is not defined %}
        <button
            type="button"
            class="icon-btn"
            aria-label="Ajouter à une playlist"
            data-action="add-to-playlist#open"
            data-add-to-playlist-track-id-param="{{ track.id }}"
        >
            {{ ux_icon('material-symbols:playlist-add') }}
        </button>
    {% else %}
        <form method="post" action="{{ path('app_playlist_remove_track', {id: playlist.id}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('playlist_remove_track') }}">
            <input type="hidden" name="track" value="{{ track.id }}">
            <button class="icon-btn" aria-label="Retirer de la playlist" type="submit">{{ ux_icon('material-symbols:playlist-remove') }}</button>
        </form>

        {% include "playlist/_track_actions.html.twig" %}
    {% endif %}
</li>
