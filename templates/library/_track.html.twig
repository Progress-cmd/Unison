{% set artists = track.artists|map(artist => artist.name)|join(', ') %}
{# The track as the player and the options sheet use it (same fields as App\Playback\Service\QueueItems). #}
{% set item = {
    id: track.id,
    url: path('app_track_stream', {id: track.id}),
    title: track.title,
    artists: artists,
    cover: track.cover,
    waveform: track.waveform,
    playlistsUrl: path('app_track_playlists', {id: track.id}),
    album: track.album ? {title: track.album.title, url: path('app_albums_show', {id: track.album.id})} : null,
    artistLinks: track.artists|map(artist => {name: artist.name, url: path('app_artists_show', {id: artist.id})}),
} %}

<li
    class="track track-{{ track.id }}{{ inPlaylist is defined ? ' track--in-playlist' }}"
    data-track-list-target="track"
    data-url="{{ item.url }}"
    data-track="{{ item|json_encode }}"
    {% if inPlaylist is defined %}style="view-transition-name: track-{{ track.id }}"{% endif %}
>
    <button
        type="button"
        class="icon-btn"
        aria-label="Lire {{ track.title }}"
        data-action="track-list#play"
    >
        {{ ux_icon('material-symbols:play-arrow') }}
    </button>

    {% if track.cover %}
        <img class="track-cover" src="{{ track.cover }}" alt="" loading="lazy">
    {% else %}
        <div class="track-cover"></div>
    {% endif %}

    <div class="track-info">
        <span class="track-title">{{ track.title }}</span>
        <span class="track-artists">{{ artists }}</span>
        {% if user is defined %}
            <span class="track-user">{{ user }}</span>
        {% endif %}
    </div>

    <span class="track-duration">{{ track.duration|duration }}</span>

    {% include 'library/_favorite_button.html.twig' with {isFavorite: track.id in favoriteIds} %}

    {# Écouter juste après, ajouter à la file ou à une playlist, voir l'album ou l'artiste. #}
    <button
        type="button"
        class="icon-btn"
        aria-label="Options de « {{ track.title }} »"
        aria-haspopup="dialog"
        data-action="track-options#open"
    >
        {{ ux_icon('material-symbols:more-vert') }}
    </button>

    {% if inPlaylist is defined %}
        <form method="post" action="{{ path('app_playlist_remove_track', {id: playlist.id}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('playlist_remove_track') }}">
            <input type="hidden" name="track" value="{{ track.id }}">
            <button class="icon-btn" aria-label="Retirer de la playlist" type="submit">{{ ux_icon('material-symbols:playlist-remove') }}</button>
        </form>

        {% include "playlist/_track_actions.html.twig" %}
    {% endif %}
</li>
