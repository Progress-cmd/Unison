<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Unison{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/icons/favicon.svg') }}">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% if app.user %}
            <header>
                <a href="{{ path('app_home') }}">Unison</a>
                <div class="username">{{ app.user.username }}</div>
                <a href="{{ path('app_import') }}">Importer</a>
                <a href="{{ path('app_logout') }}">Déconnexion</a>
            </header>
        {% endif %}

        <main>
            <div class="notif">
                {% for message in app.flashes('success') %}
                    <p>{{ message }}</p>
                {% endfor %}
                {% block notif %}{% endblock %}
            </div>
            {% block body %}{% endblock %}
        </main>
        {% if app.user %}
            <div id="player" data-turbo-permanent></div>
        {% endif %}
    </body>
</html>
