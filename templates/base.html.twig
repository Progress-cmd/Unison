<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Unison{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/icons/favicon.svg') }}">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&family=DM+Sans:wght@400;500&display=swap">
        {% block stylesheets %}{% endblock %}

        {# After a form redirects to the page it came from, keep the scroll position. #}
        <meta name="turbo-refresh-scroll" content="preserve">
        {% block meta %}{% endblock %}
        
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% if app.user %}
            <nav class="navbar">
                <div class="nav-brand desktop-only">Unison</div>
                <a class="nav-item" href="{{ path('app_home') }}">Accueil</a>
                <a class="nav-item" href="{{ path('app_library') }}">Bibliothèque</a>
                <a class="nav-item" href="{{ path('app_import') }}">Importer</a>
                <div class="username desktop-only">{{ app.user.username }}</div>
                <form action="{{ path('app_logout') }}" method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button class="nav-item" type="submit">Déconnexion</button>
                </form>
            </nav>
        {% endif %}

        <main>
            {% if app.user %}
                <header class="topbar">
                    {% include "shared/_scope_switch.html.twig" %}
                </header>
            {% endif %}
            <div class="notif">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <p class="alert alert-{{ type }}">{{ message }}</p>
                    {% endfor %}
                {% endfor %}
                {% block notif %}{% endblock %}
            </div>
            {% block body %}{% endblock %}
        </main>
        {% if app.user %}
            {% include 'playback/_player.html.twig' %}
        {% endif %}
    </body>
</html>
