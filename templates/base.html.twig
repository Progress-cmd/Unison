<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Unison{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/icons/favicon.svg') }}">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&family=DM+Sans:wght@400;500&display=swap">
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% if app.user %}
            <nav class="navbar">
                <div class="nav-brand desktop-only">Unison</div>
                <a class="nav-item" href="{{ path('app_home') }}">Accueil</a>
                <a class="nav-item" href="{{ path('app_library') }}">Bibliothèque</a>
                <a class="nav-item" href="{{ path('app_import') }}">Importer</a>
                <div class="username desktop-only">{{ app.user.username }}</div>
                <form action="{{ path('app_logout') }}" method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button class="nav-item" type="submit">Déconnexion</button>
                </form>
            </nav>
        {% endif %}

        <main>
            <div class="notif">
                {% for message in app.flashes('success') %}
                    <p class="alert alert-success">{{ message }}</p>
                {% endfor %}
                {% block notif %}{% endblock %}
            </div>
            {% block body %}{% endblock %}
        </main>
        {% if app.user %}
            <div id="player" class="player" data-controller="player" data-action="track-list:play@window->player#play" data-turbo-permanent>
                <button class="icon-btn" type="button" data-action="player#previous" aria-label="Morceau précédent">{{ ux_icon('material-symbols:skip-previous') }}</button>
                <button type="button" class="icon-btn" data-player-target="toggle" data-action="player#toggle" aria-label="Lecture">
                    {{ ux_icon('material-symbols:play-arrow', {class: 'icon-play'}) }}
                    {{ ux_icon('material-symbols:pause', {class: 'icon-pause'}) }}
                </button>
                <button class="icon-btn" type="button" data-action="player#next" aria-label="Morceau suivant">{{ ux_icon('material-symbols:skip-next') }}</button>

                <span data-player-target="title" class="player-title"></span>
                <span class="player-time desktop-only" data-player-target="elapsed">0:00</span>
                <input class="player-progress" type="range" min="0" max="100" value="0" step="0.1" aria-label="Position dans le morceau" data-player-target="progress" data-action="input->player#seek">
                <span class="player-time desktop-only" data-player-target="duration">0:00</span>

                <audio data-player-target="audio" data-action="play->player#showPlaying pause->player#showPaused loadedmetadata->player#updateDuration timeupdate->player#updateProgress ended->player#next"></audio>
            </div>
        {% endif %}
    </body>
</html>
