{# Inline styles only: mail clients ignore the site's stylesheets. #}
<div style="max-width: 480px; margin: 0 auto; padding: 24px; font-family: Arial, sans-serif; color: #222; line-height: 1.5;">
    <h1 style="margin: 0 0 16px; font-family: Georgia, serif; font-weight: normal;">Unison</h1>

    <p>Bonjour {{ username }},</p>

    {% if welcome %}
        <p>Un compte Unison vient d'être créé pour toi. Il ne te reste qu'à choisir ton mot de passe :</p>
    {% else %}
        <p>Ton mot de passe Unison a été réinitialisé. Choisis-en un nouveau :</p>
    {% endif %}

    {% set link = url('app_reset_password_token', {token: token}) %}
    <p style="margin: 24px 0;">
        <a href="{{ link }}"
           style="display: inline-block; padding: 10px 18px; border-radius: 8px; background: #B44C30; color: #fff; text-decoration: none; font-weight: bold;">
            Choisir mon mot de passe
        </a>
    </p>

    {# The address in clear too: the text version of the email loses the button's link. #}
    <p style="font-size: 14px; color: #666;">
        Si le bouton ne marche pas, copie ce lien dans ton navigateur :<br>
        <a href="{{ link }}" style="color: #B44C30; word-break: break-all;">{{ link }}</a>
    </p>

    <p style="font-size: 14px; color: #666;">
        Le lien fonctionne une seule fois, pendant 7 jours.
        {% if not welcome %}En attendant, ton ancien mot de passe marche encore.{% endif %}
    </p>
</div>
