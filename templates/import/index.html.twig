{% extends 'base.html.twig' %}

{% block title %}Unison - Importation{% endblock %}

{% block section %}import{% endblock %}

{% block body %}
<header class="import-header">
    <h1>Importer</h1>
    <p class="import-subtitle">Cherche un titre, ou colle directement des liens YouTube.</p>
</header>

<div class="import-layout">
    <div class="import-main">
        <form class="search-bar" action="{{ path('app_import') }}" method="get" role="search" data-controller="magic-words" data-action="submit->magic-words#check">
            {{ ux_icon('material-symbols:search', {class: 'search-bar-icon'}) }}
            <input type="search" name="q" value="{{ q }}" placeholder="Titre ou artiste" aria-label="Rechercher" autocomplete="off" enterkeyhint="search" data-magic-words-target="input">
            <button type="submit" class="search-bar-submit" aria-label="Rechercher">
                {{ ux_icon('material-symbols:arrow-forward') }}
            </button>
        </form>

        {% if q %}
            <section class="search-results" aria-label="Résultats pour « {{ q }} »">
                <h2 class="search-group">
                    {{ ux_icon('material-symbols:library-music-outline') }}
                    Dans ta bibliothèque
                    {% if results %}<span class="search-count">{{ results|length }}</span>{% endif %}
                </h2>
                <ul class="track-list" data-controller="track-list" data-action="player:change@window->track-list#highlight">
                    {% for result in results %}
                        {% include 'library/_track.html.twig' with {track: result} %}
                    {% else %}
                        <li>Rien dans ta bibliothèque pour « {{ q }} ».</li>
                    {% endfor %}
                </ul>

                <h2 class="search-group">
                    {{ ux_icon('material-symbols:smart-display-outline') }}
                    Sur YouTube Music
                </h2>
                {# Placeholder rows while YouTube Music answers: Turbo replaces them with the response. #}
                <turbo-frame id="youtube-results" src="{{ path('app_import_youtube', {q: q}) }}" loading="lazy">
                    <p class="youtube-loading" role="status">Recherche sur YouTube Music…</p>
                    <ul class="track-list youtube-skeleton" aria-hidden="true">
                        {% for i in 1..3 %}
                            <li class="track">
                                <span class="track-cover"></span>
                                <span class="track-info">
                                    <span class="skeleton-line"></span>
                                    <span class="skeleton-line skeleton-line--short"></span>
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                </turbo-frame>
            </section>
        {% else %}
            <div class="search-hint">
                {{ ux_icon('material-symbols:queue-music') }}
                <p>Ta bibliothèque d'abord, puis YouTube :<br>un clic suffit pour importer ce qui te manque.</p>
            </div>
        {% endif %}
    </div>

    <aside class="import-side">
        {{ form_start(form, {attr: {class: 'form import-card', 'data-controller': 'import-preview'}}) }}
            <h2 class="import-heading">Coller des liens</h2>

            {{ form_row(form.urls) }}

            <ol class="import-list import-preview" data-import-preview-target="list"></ol>
            <template data-import-preview-target="row">
                <li class="import-preview-row">
                    <span class="import-icon">
                        {{ ux_icon('material-symbols:check-circle-outline', {class: 'icon-ok'}) }}
                        {{ ux_icon('material-symbols:progress-activity', {class: 'icon-loading'}) }}
                        {{ ux_icon('material-symbols:playlist-play', {class: 'icon-playlist'}) }}
                        {{ ux_icon('material-symbols:cancel-outline', {class: 'icon-failed'}) }}
                    </span>
                    <span class="import-url"></span>
                </li>
            </template>

            <button type="submit" class="btn import-submit">Importer</button>
        {{ form_end(form) }}

        <turbo-frame id="import-jobs" src="{{ path('app_import_jobs') }}"></turbo-frame>
    </aside>
</div>
{% endblock %}
