{% extends 'base.html.twig' %}

{% block title %}Unison - Contenu{% endblock %}

{% block section %}admin{% endblock %}

{% block body %}
<header class="admin-header">
    <h1>Administration</h1>
    <p class="admin-subtitle">Corriger ou supprimer ce qui a été importé.</p>
</header>
{% include 'admin/_tabs.html.twig' with {active: 'content'} %}

{# Same search bar as the import page. #}
<form class="search-bar content-search" action="{{ path('app_admin_content') }}" method="get" role="search">
    {{ ux_icon('material-symbols:search', {class: 'search-bar-icon'}) }}
    <input type="search" name="q" value="{{ q }}" placeholder="Titre ou artiste" aria-label="Rechercher un titre" autocomplete="off" enterkeyhint="search">
    <button type="submit" class="search-bar-submit" aria-label="Rechercher">
        {{ ux_icon('material-symbols:arrow-forward') }}
    </button>
</form>

{# Albums first: deleting one takes all its tracks, so they get their own page. #}
{% if albums or q %}
    <section class="content-group" aria-labelledby="content-albums">
        <h2 class="admin-heading" id="content-albums">
            {{ q ? 'Albums' : 'Derniers albums' }}
            {% if albums %}<span class="admin-count">{{ albums|length }}</span>{% endif %}
        </h2>

        <ul class="content-list">
            {% for album in albums %}
                {% set count = album.tracks|length %}
                <li class="content-item">
                    {% if album.cover %}
                        <img class="content-cover" src="{{ album.cover }}" alt="" loading="lazy">
                    {% else %}
                        <span class="content-cover"></span>
                    {% endif %}

                    <span class="content-info">
                        <span class="content-title">{{ album.title }}</span>
                        <span class="content-meta">
                            {{ album.artists|map(a => a.name)|join(', ') }}
                            · {{ count }} titre{{ count > 1 ? 's' }}
                        </span>
                    </span>

                    <a class="content-edit" href="{{ path('app_admin_content_album', {id: album.id}) }}" aria-label="Voir l'album « {{ album.title }} »">
                        {{ ux_icon('material-symbols:chevron-right') }}
                        <span class="content-edit-label">Voir</span>
                    </a>
                </li>
            {% else %}
                <li class="content-empty">Aucun album pour « {{ q }} ».</li>
            {% endfor %}
        </ul>
    </section>
{% endif %}

<section class="content-group" aria-labelledby="content-tracks">
    <h2 class="admin-heading" id="content-tracks">
        {{ q ? 'Titres' : 'Derniers titres' }}
        {% if tracks %}<span class="admin-count">{{ tracks|length }}</span>{% endif %}
    </h2>

    <ul class="content-list">
        {% for track in tracks %}
            {% include 'admin/_content_track.html.twig' %}
        {% else %}
            <li class="content-empty">
                {% if q %}
                    Aucun titre pour « {{ q }} ».
                {% else %}
                    Aucun titre dans la bibliothèque.
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</section>
{% endblock %}
