{% extends 'base.html.twig' %}

{% block title %}Unison - Administration{% endblock %}

{% block section %}admin{% endblock %}

{% block body %}
<header class="admin-header">
    <h1>Administration</h1>
    <p class="admin-subtitle">Ce qu'il y a dans Unison, et comment se passent les imports.</p>
</header>
{% include 'admin/_tabs.html.twig' with {active: 'dashboard'} %}

{# Errors first: the one thing on this page that may need doing something. #}
<a class="admin-alert{{ nbUnresolvedErrors ? ' admin-alert--warning' }}" href="{{ path('app_admin_errors') }}">
    {{ ux_icon(nbUnresolvedErrors ? 'material-symbols:error-outline' : 'material-symbols:check-circle-outline', {class: 'admin-alert-icon'}) }}
    <span class="admin-alert-text">
        {% if nbUnresolvedErrors %}
            <strong>{{ nbUnresolvedErrors }} erreur{{ nbUnresolvedErrors > 1 ? 's' }} à régler</strong>
            Imports, recherches ou pages qui ont planté.
        {% else %}
            <strong>Aucune erreur à régler</strong>
            Tout tourne normalement.
        {% endif %}
    </span>
    {{ ux_icon('material-symbols:chevron-right', {class: 'admin-alert-arrow'}) }}
</a>

<section class="admin-group" aria-labelledby="admin-library">
    <h2 class="admin-heading" id="admin-library">Bibliothèque</h2>
    <dl class="stat-grid">
        <div class="stat">
            <dt>Titres</dt>
            <dd>{{ nbTracks|number_format(0, ',', ' ') }}</dd>
        </div>
        <div class="stat">
            <dt>Artistes</dt>
            <dd>{{ nbArtists|number_format(0, ',', ' ') }}</dd>
        </div>
        <div class="stat">
            <dt>Albums</dt>
            <dd>{{ nbAlbums|number_format(0, ',', ' ') }}</dd>
        </div>
        <div class="stat">
            <dt>Durée totale</dt>
            <dd>{{ totalDuration // 3600 }}<small>h</small>{{ '%02d'|format(totalDuration % 3600 // 60) }}</dd>
        </div>
    </dl>
</section>

{# One entry per import status: label, number, and the modifier that gives its colour. #}
{% set imports = [
    {label: 'Réussis', count: nbImportDone, status: 'done'},
    {label: 'Doublons', count: nbImportDuplicate, status: 'duplicate'},
    {label: 'Échoués', count: nbImportFailed, status: 'failed'},
    {label: 'En attente', count: nbImportPending, status: 'pending'},
] %}
{% set importTotal = nbImportDone + nbImportDuplicate + nbImportFailed + nbImportPending %}

<div class="admin-columns">
    <section class="admin-group admin-card" aria-labelledby="admin-imports">
        <h2 class="admin-heading" id="admin-imports">
            Imports
            <span class="admin-count">{{ importTotal|number_format(0, ',', ' ') }}</span>
        </h2>

        {% if importTotal %}
            {# One block per status, as wide as its share. The legend below gives the numbers. #}
            <div class="import-bar" role="img" aria-label="{% for item in imports %}{{ item.label }} : {{ item.count }}{{ loop.last ? '' : ', ' }}{% endfor %}">
                {% for item in imports|filter(item => item.count > 0) %}
                    <span class="import-bar-part import-bar-part--{{ item.status }}" style="flex-grow: {{ item.count }}" title="{{ item.label }} : {{ item.count }}"></span>
                {% endfor %}
            </div>
        {% endif %}

        <ul class="import-legend">
            {% for item in imports %}
                <li class="import-legend-item import-legend-item--{{ item.status }}">
                    <span class="import-legend-label">{{ item.label }}</span>
                    <span class="import-legend-value">{{ item.count|number_format(0, ',', ' ') }}</span>
                    <span class="import-legend-share">{{ importTotal ? (item.count / importTotal * 100)|round ~ ' %' : '–' }}</span>
                </li>
            {% endfor %}
        </ul>

        {# Work time of the tracks imported successfully (milliseconds, null before any measure). #}
        {% if importDurations.average is not null %}
            <p class="import-durations">
                {{ ux_icon('material-symbols:timer-outline') }}
                <span>
                    En moyenne <strong>{{ (importDurations.average / 1000)|number_format(1, ',', ' ') }} s</strong> par titre,
                    <strong>{{ (importDurations.longest / 1000)|number_format(1, ',', ' ') }} s</strong> au plus long
                </span>
            </p>
        {% endif %}
    </section>

    <dl class="stat-grid stat-grid--side">
        <div class="stat">
            <dt>Comptes</dt>
            <dd>{{ nbComptes|number_format(0, ',', ' ') }}</dd>
        </div>
        <div class="stat">
            <dt>Titres nettoyés</dt>
            <dd>{{ nbCleaned|number_format(0, ',', ' ') }}</dd>
            {% if nbTracks %}
                <p class="stat-note">{{ (nbCleaned / nbTracks * 100)|round }} % de la bibliothèque</p>
            {% endif %}
        </div>
        {# YouTube Music answer time over the last 30 days; failures (time-outs) are counted apart. #}
        {% set nbSearches = nbSuccessedSearch + nbFailedSearch %}
        <div class="stat stat--wide">
            <dt>Recherche YouTube Music</dt>
            <dd>
                {% if averageDuration is not null %}
                    {{ (averageDuration / 1000)|number_format(1, ',', ' ') }}<small>s</small>
                {% else %}
                    –
                {% endif %}
            </dd>
            <p class="stat-note">
                {% if nbSearches %}
                    En moyenne sur {{ nbSearches }} recherche{{ nbSearches > 1 ? 's' }} en 30 jours
                    {%- if nbFailedSearch %}, <span class="stat-note-warning">{{ nbFailedSearch }} en échec</span>{% endif %}
                {% else %}
                    Aucune recherche ces 30 derniers jours
                {% endif %}
            </p>
        </div>
    </dl>
</div>

{% import 'shared/_charts.html.twig' as charts %}

<section class="admin-group" aria-labelledby="admin-listens">
    <h2 class="admin-heading" id="admin-listens">Écoutes</h2>
    <dl class="stat-grid stat-grid--three">
        <div class="stat">
            <dt>Écoutes</dt>
            <dd>{{ nbListens|number_format(0, ',', ' ') }}</dd>
            <p class="stat-note">Depuis le début, tous comptes</p>
        </div>
        <div class="stat">
            <dt>30 derniers jours</dt>
            <dd>{{ nbListensMonth|number_format(0, ',', ' ') }}</dd>
            <p class="stat-note">Soit {{ (nbListensMonth / 30)|number_format(1, ',', ' ') }} par jour</p>
        </div>
        {# Length of the tracks listened to: a listen counts after 30 s, so it's an upper bound. #}
        <div class="stat stat--wide">
            <dt>Temps d'écoute</dt>
            <dd>{{ listenedSecondsMonth // 3600 }}<small>h</small>{{ '%02d'|format(listenedSecondsMonth % 3600 // 60) }}</dd>
            <p class="stat-note">Sur 30 jours</p>
        </div>
    </dl>

    <div class="chart-grid">
        <section class="admin-card chart-card" aria-labelledby="chart-days">
            <h3 class="chart-title" id="chart-days">Par jour</h3>
            <p class="chart-subtitle">Les 30 derniers jours</p>
            {{ charts.columns(listensByDay, 'écoute', 'écoutes', 5, 10) }}
        </section>
        <section class="admin-card chart-card" aria-labelledby="chart-hours">
            <h3 class="chart-title" id="chart-hours">Au fil de la journée</h3>
            <p class="chart-subtitle">Toutes les écoutes, par heure</p>
            {{ charts.columns(listensByHour, 'écoute', 'écoutes', 3, 6) }}
        </section>
    </div>
</section>

<section class="admin-group" aria-labelledby="admin-rankings">
    <h2 class="admin-heading" id="admin-rankings">Palmarès</h2>
    <div class="chart-grid chart-grid--three">
        <section class="admin-card chart-card" aria-labelledby="ranking-tracks">
            <h3 class="chart-title" id="ranking-tracks">Titres les plus écoutés</h3>
            {{ charts.ranking(topTracks|map(row => {
                name: row[0].title,
                detail: row[0].artists|map(artist => artist.name)|join(', '),
                value: row.listens,
            }), 'Aucune écoute pour l\'instant.') }}
        </section>
        <section class="admin-card chart-card" aria-labelledby="ranking-artists">
            <h3 class="chart-title" id="ranking-artists">Artistes les plus écoutés</h3>
            {{ charts.ranking(topArtists|map(row => {name: row[0].name, value: row.listens}), 'Aucune écoute pour l\'instant.') }}
        </section>
        <section class="admin-card chart-card" aria-labelledby="ranking-accounts">
            <h3 class="chart-title" id="ranking-accounts">Écoutes par compte</h3>
            {{ charts.ranking(listensPerAccount|map(row => {name: row[0].username, value: row.listens}), 'Aucune écoute pour l\'instant.') }}
        </section>
    </div>
</section>

<section class="admin-group" aria-labelledby="admin-growth">
    <h2 class="admin-heading" id="admin-growth">Croissance et disque</h2>
    <div class="admin-columns">
        <section class="admin-card chart-card" aria-labelledby="chart-months">
            <h3 class="chart-title" id="chart-months">Titres ajoutés par mois</h3>
            <p class="chart-subtitle">Les 12 derniers mois</p>
            {{ charts.columns(tracksByMonth, 'titre', 'titres', 1, 2) }}
        </section>

        {% set music = disk.music|file_size %}
        {% set covers = disk.covers|file_size %}
        <dl class="stat-grid stat-grid--side">
            <div class="stat">
                <dt>Musiques</dt>
                <dd>{{ music.value }}<small>{{ music.unit }}</small></dd>
            </div>
            <div class="stat">
                <dt>Pochettes</dt>
                <dd>{{ covers.value }}<small>{{ covers.unit }}</small></dd>
            </div>
            <div class="stat stat--wide">
                <dt>Libre sur le disque</dt>
                {% if disk.free is not null %}
                    {% set free = disk.free|file_size %}
                    <dd>{{ free.value }}<small>{{ free.unit }}</small></dd>
                {% else %}
                    <dd>–</dd>
                {% endif %}
            </div>
        </dl>
    </div>
</section>
{% endblock %}
