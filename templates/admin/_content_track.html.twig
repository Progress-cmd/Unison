{# One track row of the content pages, with its "Modifier" link. On an album page: showNumber (track number instead of the cover) and showAlbum: false. #}
<li class="content-item">
    {% if showNumber|default(false) %}
        <span class="content-number">{{ track.trackNumber ?? '–' }}</span>
    {% elseif track.cover %}
        <img class="content-cover" src="{{ track.cover }}" alt="" loading="lazy">
    {% else %}
        <span class="content-cover"></span>
    {% endif %}

    <span class="content-info">
        <span class="content-title">{{ track.title }}</span>
        <span class="content-meta">
            {{ track.artists|map(a => a.name)|join(', ') }}
            {% if track.album and showAlbum|default(true) %}<span class="content-album">· {{ track.album.title }}</span>{% endif %}
        </span>
    </span>

    <a class="content-edit" href="{{ path('app_admin_content_edit', {id: track.id}) }}" aria-label="Modifier « {{ track.title }} »">
        {{ ux_icon('material-symbols:edit') }}
        <span class="content-edit-label">Modifier</span>
    </a>
</li>
