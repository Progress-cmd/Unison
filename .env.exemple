# Modèle à copier en .env (cp .env.exemple .env) puis à adapter. Le vrai .env n'est jamais commité.

# Docker : utilisateur de la machine (commande `id -u` et `id -g`)
UID=1000
GID=1000
PORT_EXPOSE=8083

# Base de données
DB_ROOTPASS=changeme-root
DB_NAME=unison
DB_USER=unison
DB_PASS=changeme

# Symfony
APP_ENV=dev
APP_SECRET=changeme-une-longue-chaine-aleatoire

DEFAULT_URI=http://localhost:8083

# Prod uniquement (laisser commenté en dev), lus directement par Symfony :
# - adresses du site acceptées (expression régulière). Les liens des e-mails sont construits
#   avec l'adresse de la requête : sans ça, une requête trafiquée pourrait envoyer un lien
#   vers un autre site.
# SYMFONY_TRUSTED_HOSTS='^unison\.exemple\.fr$'
# - derrière le proxy HTTPS (Caddy, nginx…) : sans ça, tous les visiteurs ont l'adresse IP
#   du proxy, et la limite « Mot de passe oublié ? » (5 demandes par quart d'heure) devient
#   commune à tout le monde.
# SYMFONY_TRUSTED_PROXIES=private_ranges

# Données
MUSIC_DIR=%kernel.project_dir%/musics_storage

# E-mails (liens « Choisis ton mot de passe »)
# En dev : Mailpit les attrape tous, à lire sur http://localhost:8025
# En prod : le SMTP du fournisseur, ex. smtp://utilisateur:motdepasse@smtp.exemple.fr:587
MAILER_DSN=smtp://mailer:1025
MAILER_FROM=unison@localhost

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###
