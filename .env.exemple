# Modèle à copier en .env (cp .env.exemple .env) puis à adapter. Le vrai .env n'est jamais commité.

# Docker : utilisateur de la machine (commande `id -u` et `id -g`)
UID=1000
GID=1000
PORT_EXPOSE=8083

# Base de données
DB_ROOTPASS=changeme-root
DB_NAME=unison
DB_USER=unison
DB_PASS=changeme

# Symfony
APP_ENV=dev
APP_SECRET=changeme-une-longue-chaine-aleatoire

DEFAULT_URI=http://localhost:8083

# Données
MUSIC_DIR=%kernel.project_dir%/musics_storage

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###
